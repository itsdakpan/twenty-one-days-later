156:              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
157:            </div>
158:            <div class="modal-body">
159:              <%= f.input :message, label_html: { class: "d-none" }, placeholder: "Comment here...", class: "review" %>
160:            </div>
161:            <div class="modal-footer">
162:    
163:            <%= f.button :submit, value:"Add a comment", class: "btn" %>
164:            </div>
165:          <% end %>
166:        </div>
167:        </div>
168:        </div>

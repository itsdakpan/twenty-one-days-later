176:        document.addEventListener("turbo:load", function () {
177:          function updateCountdown(elementId, endDateStr) {
178:            const countdownElement = document.getElementById(elementId);
179:            if (!countdownElement) return;
180:    
181:            const endDate = new Date(endDateStr).getTime();
182:            const now = new Date().getTime();
183:            const difference = endDate - now;
184:            const daysLeft = Math.ceil(difference / (1000 * 60 * 60 * 24));
185:    
186:            countdownElement.innerText =
187:              daysLeft > 0 ? `⏳ ${daysLeft} days left!` : "✅ Goal deadline reached!";
188:          }
189:    
190:          document.querySelectorAll("[id^='pre-start-countdown-']").forEach(preStartCountdown => {
191:            const startDateStr = preStartCountdown.dataset.startDate;
192:            if (!startDateStr) return;
193:    
194:            const startDate = new Date(startDateStr).getTime();
195:    
196:            setInterval(() => {
197:              const today = new Date().getTime();
198:              const difference = startDate - today;
199:              const daysUntilStart = Math.ceil(difference / (1000 * 60 * 60 * 24));
200:    
201:              preStartCountdown.innerText = `🚀 ${daysUntilStart} days until the goal begins!`;
202:    
203:              if (daysUntilStart <= 0) {
204:                preStartCountdown.style.display = "none"; // Hide pre-start message
205:                const countdownElement = document.getElementById(`countdown-${preStartCountdown.id.replace("pre-start-countdown-", "")}`);
206:                if (countdownElement) {
207:                  countdownElement.style.display = "block"; // Show the countdown when the goal starts
208:                  updateCountdown(countdownElement.id, countdownElement.dataset.endDate);
209:                  setInterval(() => updateCountdown(countdownElement.id, countdownElement.dataset.endDate), 1000);
210:                }
211:    
212:              <%= f.button :submit, class: "btn" %>
213:            </div>
214:          <% end %>
215:        </div>
216:      </div>
217:    </div>

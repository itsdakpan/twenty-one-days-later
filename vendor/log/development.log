61:              <p><strong>Start Date:</strong> <%= goal.start_date.present? ? goal.start_date.strftime("%d %b %Y") : "Not set" %></p>
62:              
63:              <% if goal.start_date.present? %>
64:                <% days_until_start = (goal.start_date - Date.today).to_i %>
65:                <% days_left = (goal.end_date - Date.today).to_i %>
66:    
67:                <% if days_until_start.positive? %>
68:                  <p id="pre-start-countdown-<%= goal.id %>" data-start-date="<%= goal.start_date %>">
69:                    🚀 <strong><%= days_until_start %> days until <%= goal.name %> begins!</strong>
70:                  </p>
71:                <% elsif days_left.positive? %>
72:                  <p id="countdown-<%= goal.id %>" data-end-date="<%= goal.end_date %>">
73:                    ⏳ <strong><%= days_left %> days left!</strong>
74:                  </p>
75:                <% else %>
76:                  <p>✅ <strong>Goal deadline reached!</strong></p>
77:                <% end %>
78:              <% else %>
79:                <p><em>Start date not set for this goal.</em></p>
80:              <% end %>
81:            </div>
82:          <% end %>
83:        </div>
84:      <% end %>
85:    
86:      <div class="member-progress-header">
87:        <h2>Member Progress</h2>
88:      </div>
89:    
90:      <div class="members-container">
91:        <% @group.members.each do |member| %>
92:          <div class="member-row">
93:            <div class="member-info">
94:              <div class="img-box">
95:                <% if member.photo.attached? %>
96:                <%= cl_image_tag member.photo.key, class: ".avatar-square", alt: "avatar", height: 100, width: 100, crop: :fill %>
97:                <% else %>
98:                 <%= image_tag "default-avatar.svg", class: "avatar-square", alt: "avatar", height: 100, width: 100 %>
99:                  <% end %>
100:              </div>
101:              <h4><%= member.first_name %></h4>
102:            </div>
103:            
104:            <div class="member-card">
105:              <div class="progress-stars" data-controller="progress-stars" data-group-id="<%= @group.id %>">
106:                <div class="stars-row">
107:                  <% 11.times do |i| %>
108:                    <span class="star" data-progress-stars-target="star" data-day="<%= i %>">
109:                      <i class="fa-regular fa-star"></i>
110:                    </span>
111:                  <% end %>
112:                </div>
113:                <div class="stars-row">
114:                  <% 10.times do |i| %>
115:                    <span class="star" data-progress-stars-target="star" data-day="<%= i + 11 %>">
116:                      <i class="fa-regular fa-star"></i>
117:                    </span>
118:                  <% end %>
119:                  <i id="checkmark-21-<%= @group.id %>" class="fas fa-check-circle"></i>
120:                      <button type="button" class="comment-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">
121:                 <i class="fas fa-comment-alt"></i>
122:                </button>
123:                </div>
124:             
125:              </div>
126:              
127:              <%# <div class="member-actions">
128:                <span class="days-left">20 more days left</span>
129:                
130:              </div> %>
131:            </div>
132:          </div>
133:        <% end %>
134:      </div>
135:    
136:      <p style="display: none;"><strong>Members:</strong> <%= @group.members.count %></p>
137:    
138:    
139:      <div class="member-progress-header">
140:        <h2>Comments</h2>
141:      </div>
142:    
143:    
144:      <div class="members-container">
145:        <%= render "comments/comments_list", comments: @comments %>
146:      </div>
147:    </div>
148:    
149:    <!-- Modal -->
150:    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
151:      <div class="modal-dialog">
152:        <div class="modal-content">
153:          <%= simple_form_for [@group, @comment] do |f| %>
154:            <div class="modal-header">

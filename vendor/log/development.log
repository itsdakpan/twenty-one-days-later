        setInterval(() => {
          const today = new Date().getTime();
          const difference = startDate - today;
          const daysUntilStart = Math.ceil(difference / (1000 * 60 * 60 * 24));

          preStartCountdown.innerText = `🚀 ${daysUntilStart} days until the goal begins!`;


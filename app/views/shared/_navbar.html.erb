<header class="topbar">
  <div class="wrap topbar__inner">
    <%= link_to (user_signed_in? ? groups_path : root_path), class: "topbar__brand" do %>
      <%= image_tag "logo.svg", alt: "", width: 32, height: 32 %>
      <span>21 Days Later</span>
    <% end %>

    <% if user_signed_in? %>
      <nav class="topbar__links" aria-label="Main">
        <%= nav_link "My groups", groups_path, icon: "fa-layer-group" %>
        <%= nav_link "New group", new_group_path, icon: "fa-plus" %>
      </nav>

      <details class="topbar__user">
        <summary aria-label="Account menu">
          <%= avatar_for current_user, size: :sm %>
          <span class="topbar__user-name"><%= current_user.display_name %></span>
          <i class="fa-solid fa-chevron-down muted" style="font-size: .7rem" aria-hidden="true"></i>
        </summary>
        <div class="topbar__menu">
          <%= link_to edit_user_registration_path do %>
            <i class="fa-regular fa-user" aria-hidden="true"></i> Account
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete do %>
            <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sign out
          <% end %>
        </div>
      </details>
    <% else %>
      <nav class="topbar__links" aria-label="Main">
        <%= link_to "Log in", new_user_session_path %>
      </nav>
      <%= link_to "Start a challenge", new_user_registration_path, class: "button button--small" %>
    <% end %>
  </div>
</header>

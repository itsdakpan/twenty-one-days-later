<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | 21 Days Later" : "21 Days Later | Build habits together" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Build a new habit in 21 days with friends and family. Set a challenge, check in daily and keep each other going.">
    <meta name="theme-color" content="#F5F4F8">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Geist:wght@400;500;600&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= yield(:body_class) %>">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/navbar" unless content_for?(:bare) %>
    <%= render "shared/flashes" %>

    <main id="main">
      <%= yield %>
    </main>
  </body>
</html>

<% content_for :title, "My groups" %>

<div class="wrap page">
  <div class="page-head rise">
    <div>
      <h1>Hi <%= current_user.display_name %>.</h1>
      <p>
        <% if @groups.any? %>
          You're in <%= pluralize(@groups.size, "group") %>. Here's where everyone's at.
        <% else %>
          You're not in any groups yet.
        <% end %>
      </p>
    </div>
    <%= link_to new_group_path, class: "button" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i> New group
    <% end %>
  </div>

  <div class="nudge rise" style="--i: 1" data-controller="quotes">
    <i class="fa-solid fa-quote-left" aria-hidden="true"></i>
    <div>
      <div class="nudge__loading" data-quotes-target="loading"></div>
      <p class="nudge__quote" data-quotes-target="quote"></p>
      <p class="nudge__author" data-quotes-target="author"></p>
    </div>
  </div>

  <% if @groups.any? %>
    <div class="group-grid">
      <% @groups.each_with_index do |group, index| %>
        <% goal = group.goal %>
        <article class="group-card rise" style="--i: <%= index + 2 %>">
          <div class="group-card__top">
            <%= goal_status_tag(goal) %>
            <% if group.owned_by?(current_user) %>
              <%= button_to group_path(group), method: :delete, class: "icon-button icon-button--danger",
                            form: { data: { turbo_confirm: "Delete #{group.name}? Everyone loses their progress." } },
                            aria: { label: "Delete #{group.name}" } do %>
                <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>

          <div>
            <h2><%= link_to group.name, group_path(group) %></h2>
            <p class="group-card__challenge">
              <% if goal %>
                <strong><%= goal.name %></strong>
              <% else %>
                No challenge set yet.
              <% end %>
            </p>
          </div>

          <% if goal %>
            <div class="group-card__bar" aria-hidden="true">
              <% Goal::CHALLENGE_DAYS.times do |i| %>
                <% date = goal.day_date(i) %>
                <span class="<%= 'is-past' if date < Date.current %> <%= 'is-today' if date == Date.current %>"></span>
              <% end %>
            </div>
          <% end %>

          <div class="group-card__foot">
            <div class="avatar-stack">
              <% group.members.first(5).each do |member| %>
                <%= avatar_for member, size: :sm %>
              <% end %>
              <% if group.members.size > 5 %>
                <span class="avatar-stack__more">+<%= group.members.size - 5 %></span>
              <% end %>
            </div>
            <span><%= pluralize(group.members.size, "member") %></span>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state rise" style="--i: 2">
      <%= image_tag "fv2.png", alt: "", width: 540, height: 380 %>
      <div>
        <h2>Start your first group.</h2>
        <p>Name it, add a few people by username, then set a 21-day challenge you'll all do together.</p>
        <%= link_to "Create a group", new_group_path, class: "button" %>
      </div>
    </div>
  <% end %>
</div>

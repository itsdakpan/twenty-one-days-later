<% content_for :title, @group.name %>
<% today_index = @goal ? (Date.current - @goal.start_date).to_i : nil %>

<div class="wrap page">
  <%= link_to groups_path, class: "back-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> My groups
  <% end %>

  <header class="group-hero rise">
    <div>
      <%= goal_status_tag(@goal) %>
      <h1><%= @group.name %></h1>
      <% if @goal %>
        <p class="group-hero__challenge"><strong><%= @goal.name %></strong>, <%= @goal.start_date.strftime("%-d %b") %> to <%= @goal.end_date.strftime("%-d %b %Y") %></p>
        <p class="group-hero__reason"><%= @goal.reason %></p>
      <% end %>
    </div>
    <div class="group-hero__actions">
      <% if @goal %>
        <%= link_to edit_group_goal_path(@group, @goal), class: "button button--ghost button--small" do %>
          <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Edit challenge
        <% end %>
      <% end %>
    </div>
  </header>

  <% if @goal %>
    <% checked_today = today_index && @completed_days.count { |_, days| days.include?(today_index) } %>
    <div class="stat-row rise" style="--i: 1">
      <div>
        <div class="stat-row__value">
          <% case @goal.status when :upcoming %><%= @goal.days_until_start %><% when :active %><%= @goal.days_left %><% else %>0<% end %>
        </div>
        <div class="stat-row__label">
          <% case @goal.status when :upcoming %>days until day one<% when :active %><%= "day".pluralize(@goal.days_left) %> left<% else %>days left, all done<% end %>
        </div>
      </div>
      <div>
        <div class="stat-row__value"><%= @goal.status == :active ? checked_today : "-" %>/<%= @members.size %></div>
        <div class="stat-row__label">checked in today</div>
      </div>
      <div>
        <div class="stat-row__value" data-progress-count><%= @completed_days[current_user.id].size %>/21</div>
        <div class="stat-row__label">your squares</div>
      </div>
    </div>

    <div class="section-title">
      <h2>The board</h2>
      <p>Tap a square once you've done the day.</p>
    </div>

    <div class="board">
      <% @members.sort_by { |m| m == current_user ? 0 : 1 }.each_with_index do |member, index| %>
        <% mine = member == current_user %>
        <% done_days = @completed_days[member.id] %>
        <div class="member rise <%= 'is-me' if mine %>" style="--i: <%= index + 2 %>"
             <% if mine %>
               data-controller="progress"
               data-progress-url-value="<%= update_progress_group_goal_completions_path(@group) %>"
               data-progress-total-value="<%= Goal::CHALLENGE_DAYS %>"
             <% end %>>
          <div class="member__who">
            <%= avatar_for member %>
            <div>
              <div class="member__name"><%= mine ? "You" : member.display_name %></div>
              <div class="member__count"><span <%= 'data-progress-target=count' if mine %>><%= done_days.size %></span> of 21 days</div>
            </div>
          </div>

          <div class="day-grid" role="group" aria-label="<%= mine ? 'Your' : "#{member.display_name}'s" %> 21 days">
            <% Goal::CHALLENGE_DAYS.times do |i| %>
              <% done = done_days.include?(i) %>
              <% classes = ["day", ("is-done" if done), ("is-today" if i == today_index)].compact.join(" ") %>
              <% if mine %>
                <% locked = today_index.nil? || i > today_index %>
                <button type="button" class="<%= classes %> <%= 'is-locked' if locked %>"
                        data-progress-target="day" data-day="<%= i %>"
                        data-action="progress#toggle"
                        aria-pressed="<%= done %>"
                        aria-label="Day <%= i + 1 %><%= ', not open yet' if locked %>"
                        <%= 'disabled' if locked %>><%= i + 1 %></button>
              <% else %>
                <span class="<%= classes %> <%= 'is-locked' if today_index.nil? || i > today_index %>" aria-label="Day <%= i + 1 %> <%= done ? 'done' : 'not done' %>"><%= i + 1 %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state rise" style="--i: 1">
      <%= image_tag "intro.png", alt: "", width: 540, height: 540 %>
      <div>
        <h2>Set the challenge.</h2>
        <p>Pick one daily habit and a start date. Everyone in <%= @group.name %> gets the same 21-day board.</p>
        <%= link_to "Set a challenge", new_group_goal_path(@group), class: "button" %>
      </div>
    </div>
  <% end %>

  <section id="comments" class="mt-5">
    <div class="section-title">
      <h2>Comments</h2>
      <p><%= pluralize(@comments.size, "comment") %></p>
    </div>

    <div class="comments">
      <%= form_with model: [@group, @comment], class: "comment-form" do |f| %>
        <%= f.label :message, "Say something to the group", class: "form-label" %>
        <%= f.text_area :message, class: "form-control", placeholder: "Day 5 done. Legs are complaining.", required: true, maxlength: 500 %>
        <div class="form-actions">
          <%= f.submit "Post", class: "button button--small" %>
        </div>
      <% end %>

      <div class="comment-list">
        <% if @comments.any? %>
          <%= render partial: "comments/comment", collection: @comments %>
        <% else %>
          <p class="comment-empty">No comments yet. Kick things off.</p>
        <% end %>
      </div>
    </div>
  </section>
</div>

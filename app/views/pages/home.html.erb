<% content_for :body_class, "landing" %>

<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <h1 class="rise">A new you in <em>21 days.</em></h1>
      <p class="hero__lead rise" style="--i: 1">Pick one habit, invite the people who keep you honest, and tick off every day together.</p>
      <div class="hero__actions rise" style="--i: 2">
        <%= link_to "Start a challenge", (user_signed_in? ? new_group_path : new_user_registration_path), class: "button" %>
        <%= link_to "Log in", new_user_session_path, class: "button button--ghost" unless user_signed_in? %>
      </div>
    </div>
    <div class="hero__art rise" style="--i: 1">
      <%= image_tag "fv1.png", alt: "Two friends helping each other climb to a flag at the top of a mountain", width: 422, height: 420, fetchpriority: "high" %>
    </div>
  </div>
</section>

<section class="together">
  <div class="wrap">
    <div class="together__panel">
      <%= image_tag "intro.png", alt: "A runner surrounded by hands giving a thumbs up", width: 540, height: 540, loading: "lazy" %>
      <div>
        <h2>It's hard to change alone. Together, it sticks.</h2>
        <p>21 Days Later is a shared check-in board for friends, families and teams. Everyone sees who showed up today, so nobody quietly gives up.</p>
      </div>
    </div>
  </div>
</section>

<section class="how" id="how-it-works">
  <div class="wrap">
    <h2>Four steps from idea to habit.</h2>
    <div class="how__grid">
      <ol class="how__steps">
        <li>
          <div>
            <h3>Pick a habit</h3>
            <p>Running, reading, no phone after 10pm. Anything you can do once a day.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Invite your people</h3>
            <p>Add friends or family by username. Everyone gets the same 21-day board.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Check in daily</h3>
            <p>Tap today's square when you've done it. Leave a comment to push the group along.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Finish together</h3>
            <p>Fill all 21 squares and the habit is yours. Then pick the next one.</p>
          </div>
        </li>
      </ol>

      <div class="how__preview" aria-hidden="true">
        <div>
          <h3>Your board, day 13</h3>
          <p>Twelve done, one missed, eight to go.</p>
        </div>
        <div class="day-grid" style="grid-template-columns: repeat(7, 1fr)">
          <% done = [0, 1, 2, 3, 5, 6, 7, 8, 9, 10, 11, 12] %>
          <% 21.times do |i| %>
            <span class="day <%= 'is-done' if done.include?(i) %>"><%= i + 1 %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="faq">
  <div class="wrap">
    <h2>Questions people ask.</h2>
    <dl>
      <div>
        <dt>Is it free?</dt>
        <dd>Yes. Make an account, start a group, invite as many people as you like.</dd>
      </div>
      <div>
        <dt>Why 21 days?</dt>
        <dd>Three weeks is long enough to build a routine and short enough to stay motivated the whole way.</dd>
      </div>
      <div>
        <dt>Can I pick any habit?</dt>
        <dd>Anything you can do once a day. Exercise, reading, cooking at home or less screen time.</dd>
      </div>
      <div>
        <dt>What if I miss a day?</dt>
        <dd>Your board shows the gap, and you carry on the next day. Showing up again is what counts.</dd>
      </div>
    </dl>
  </div>
</section>

<section class="closing">
  <div class="wrap">
    <div class="closing__panel">
      <div>
        <h2>Your next habit starts on day one.</h2>
        <%= link_to "Start a challenge", (user_signed_in? ? new_group_path : new_user_registration_path), class: "button" %>
      </div>
      <%= image_tag "fv2.png", alt: "Three people adjusting sliders together", width: 540, height: 380, loading: "lazy" %>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <span>&copy; <%= Date.current.year %> 21 Days Later. Built at Le Wagon.</span>
    <nav aria-label="Footer">
      <%= link_to "How it works", "#how-it-works" %>
      <%= link_to "Log in", new_user_session_path %>
      <%= link_to "Sign up", new_user_registration_path %>
    </nav>
  </div>
</footer>

<% content_for :title, "Edit challenge" %>

<div class="wrap form-shell">
  <%= link_to group_path(@group), class: "back-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= @group.name %>
  <% end %>

  <div class="form-card rise">
    <h1>Edit the challenge</h1>
    <p class="form-card__lead">Changing day one moves the whole 21-day board.</p>
    <%= render "form", submit_label: "Save changes" %>
  </div>
</div>

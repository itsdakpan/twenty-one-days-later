<% content_for :title, "Set a challenge" %>

<div class="wrap form-shell">
  <%= link_to group_path(@group), class: "back-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= @group.name %>
  <% end %>

  <div class="form-card rise">
    <h1>Set the challenge</h1>
    <p class="form-card__lead">One habit, every day, for 21 days. Everyone in <%= @group.name %> does it together.</p>
    <%= render "form", submit_label: "Start the challenge" %>
  </div>
</div>

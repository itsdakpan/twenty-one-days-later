<% content_for :bare, true %>
<% content_for :title, "Reset password" %>

<div class="auth">
  <%= render "devise/shared/auth_art", image: "fv2.png", line: "It happens. Let's get you back in." %>

  <div class="auth__panel">
    <div class="auth__form rise">
      <%= link_to new_user_session_path, class: "back-link" do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Log in
      <% end %>
      <h1>Forgot your password?</h1>
      <p class="auth__lead">Enter your email and we'll send you a reset link.</p>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= f.error_notification message: "Please fix the field below." %>
        <%= f.input :email, required: true, autofocus: true, input_html: { autocomplete: "email" } %>
        <%= f.button :submit, "Send reset link", class: "button button--block mt-2" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

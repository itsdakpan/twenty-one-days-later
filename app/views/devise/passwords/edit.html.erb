<% content_for :bare, true %>
<% content_for :title, "Change password" %>

<div class="auth">
  <%= render "devise/shared/auth_art", image: "fv2.png", line: "Nearly there. Pick a new password." %>

  <div class="auth__panel">
    <div class="auth__form rise">
      <h1>Change your password</h1>
      <p class="auth__lead">Choose something you haven't used here before.</p>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification message: "Please fix the fields below." %>
        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>
        <%= f.input :password, label: "New password", required: true, autofocus: true,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :password_confirmation, label: "Confirm new password", required: true, input_html: { autocomplete: "new-password" } %>
        <%= f.button :submit, "Change password", class: "button button--block mt-2" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
